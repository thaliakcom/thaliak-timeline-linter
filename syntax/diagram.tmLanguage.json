{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Thaliak Diagram",
    "scopeName": "source.diagram.thaliak",
    "patterns": [
        { "include": "#comment" },
        { "include": "#define-gradient" },
        { "include": "#define-arena" },
        { "include": "#define-kind" },
        { "include": "#define-element" },
        { "include": "#define-action" },
        { "include": "#define-strategy" },
        { "include": "#define" },
        { "include": "#text-statement" },
        { "include": "#statement" },
        { "include": "#bare-statement" },
        { "include": "#time" },
        { "include": "#continuation" }
    ],
    "repository": {
        "comment": {
            "match": "//.*$",
            "name": "comment.line.double-slash.thaliak-diagram"
        },
        "define-gradient": {
            "begin": "^(define)\\s+(gradient)\\s+(\\S+)",
            "beginCaptures": {
                "1": { "name": "keyword.other.define.thaliak-diagram" },
                "2": { "name": "storage.modifier.thaliak-diagram" },
                "3": { "name": "entity.name.type.gradient.thaliak-diagram" }
            },
            "end": "^(?=\\S)",
            "patterns": [
                { "include": "#comment" },
                { "include": "#values" }
            ]
        },
        "define-arena": {
            "comment": "`define arena` has no ID of its own.",
            "begin": "^(define)\\s+(arena)(?=\\s*(?://|$))",
            "beginCaptures": {
                "1": { "name": "keyword.other.define.thaliak-diagram" },
                "2": { "name": "storage.modifier.thaliak-diagram" }
            },
            "end": "^(?=\\S)",
            "patterns": [{ "include": "#define-body" }]
        },
        "define-kind": {
            "begin": "^(define)\\s+(actor|object|puddle|tether)\\s+(\\S+)",
            "beginCaptures": {
                "1": { "name": "keyword.other.define.thaliak-diagram" },
                "2": { "name": "storage.modifier.thaliak-diagram" },
                "3": { "name": "entity.name.type.$2.thaliak-diagram" }
            },
            "end": "^(?=\\S)",
            "patterns": [{ "include": "#define-body" }]
        },
        "define-element": {
            "begin": "^(define)\\s+(element)\\s+(\\S+)",
            "beginCaptures": {
                "1": { "name": "keyword.other.define.thaliak-diagram" },
                "2": { "name": "storage.modifier.thaliak-diagram" },
                "3": { "name": "entity.name.type.element.thaliak-diagram" }
            },
            "end": "^(?=\\S)",
            "patterns": [{ "include": "#define-body" }]
        },
        "define-action": {
            "begin": "^(define)\\s+(action)\\s+(\\S+)",
            "beginCaptures": {
                "1": { "name": "keyword.other.define.thaliak-diagram" },
                "2": { "name": "storage.modifier.thaliak-diagram" },
                "3": { "name": "entity.name.type.action.thaliak-diagram" }
            },
            "end": "^(?=\\S)",
            "patterns": [{ "include": "#define-body" }]
        },
        "define-strategy": {
            "begin": "^(define)\\s+(strategy)\\s+(\\S+)",
            "beginCaptures": {
                "1": { "name": "keyword.other.define.thaliak-diagram" },
                "2": { "name": "storage.modifier.thaliak-diagram" },
                "3": { "name": "entity.name.type.strategy.thaliak-diagram" }
            },
            "end": "^(?=\\S)",
            "patterns": [{ "include": "#define-body" }]
        },
        "define": {
            "begin": "^(define)\\s+(\\S+)",
            "beginCaptures": {
                "1": { "name": "keyword.other.define.thaliak-diagram" },
                "2": { "name": "entity.name.type.thaliak-diagram" }
            },
            "end": "^(?=\\S)",
            "patterns": [{ "include": "#define-body" }]
        },
        "define-body": {
            "patterns": [
                { "include": "#comment" },
                { "include": "#hook-key" },
                { "include": "#hook" },
                { "include": "#element-field" },
                { "include": "#headmarker-field" },
                { "include": "#values" }
            ]
        },
        "headmarker-field": {
            "comment": "An action's `headmarker: <look> at -<lead> [for <duration>] [size <size>]`.",
            "begin": "(?<![\\w-])(headmarker)\\s*(:)\\s*([a-zA-Z][\\w-]*)?",
            "beginCaptures": {
                "1": { "name": "entity.name.tag.field.thaliak-diagram" },
                "2": { "name": "punctuation.separator.key-value.mapping.thaliak-diagram" },
                "3": { "name": "variable.other.enummember.thaliak-diagram" }
            },
            "end": "$",
            "patterns": [
                { "include": "#comment" },
                { "match": "(?<![\\w-])(at|for|size)(?![\\w-])", "name": "keyword.operator.expression.thaliak-diagram" },
                { "include": "#scalars" }
            ]
        },
        "hook-key": {
            "comment": "`on:enter` and `on:exit` are one key each.",
            "match": "(?<![\\w-])(on:(?:enter|exit))\\s*(:)",
            "captures": {
                "1": { "name": "entity.name.tag.field.thaliak-diagram" },
                "2": { "name": "punctuation.separator.key-value.mapping.thaliak-diagram" }
            }
        },
        "hook": {
            "comment": "A statement of a hook: signed, or one of the unsigned verbs that move or turn (not `headmarker`, which is also a field).",
            "begin": "(?<![\\w-])(?:([+-])([a-z][a-z-]*)|(teleport|arrive|depart|move|set|turn))(:)",
            "beginCaptures": {
                "1": { "name": "entity.name.tag.verb.operator.thaliak-diagram" },
                "2": { "name": "entity.name.tag.verb.thaliak-diagram" },
                "3": { "name": "entity.name.tag.verb.thaliak-diagram" },
                "4": { "name": "punctuation.separator.key-value.mapping.thaliak-diagram" }
            },
            "end": "$",
            "patterns": [{ "include": "#arguments" }]
        },
        "element-field": {
            "begin": "(?<![\\w-])(flash|use)\\s*(:)",
            "beginCaptures": {
                "1": { "name": "entity.name.tag.field.thaliak-diagram" },
                "2": { "name": "punctuation.separator.key-value.mapping.thaliak-diagram" }
            },
            "end": "$",
            "patterns": [
                { "include": "#comment" },
                { "include": "#id" }
            ]
        },
        "time": {
            "match": "^\\d+(?=\\s*(?://|$))",
            "name": "constant.numeric.time.thaliak-diagram"
        },
        "text-statement": {
            "match": "^(\\d+)?\\s*(?:([+-])(hint|branch|strategy)|(thumbnail))(:)\\s*((?:(?!//).)*)",
            "captures": {
                "1": { "name": "constant.numeric.time.thaliak-diagram" },
                "2": { "name": "entity.name.tag.verb.operator.thaliak-diagram" },
                "3": { "name": "entity.name.tag.verb.thaliak-diagram" },
                "4": { "name": "entity.name.tag.verb.thaliak-diagram" },
                "5": { "name": "punctuation.separator.key-value.mapping.thaliak-diagram" },
                "6": { "name": "string.unquoted.plain.thaliak-diagram" }
            }
        },
        "statement": {
            "begin": "^(\\d+)?\\s*([+-])?([a-z][a-z-]*)(:)",
            "beginCaptures": {
                "1": { "name": "constant.numeric.time.thaliak-diagram" },
                "2": { "name": "entity.name.tag.verb.operator.thaliak-diagram" },
                "3": { "name": "entity.name.tag.verb.thaliak-diagram" },
                "4": { "name": "punctuation.separator.key-value.mapping.thaliak-diagram" }
            },
            "end": "$",
            "patterns": [{ "include": "#arguments" }]
        },
        "bare-statement": {
            "match": "^(\\d+)?\\s*(?:([+-])([a-z][a-z-]*)|(keyframe|skip|thumbnail|set|depart|arrive|move))(?=\\s*(?://|$))",
            "captures": {
                "1": { "name": "constant.numeric.time.thaliak-diagram" },
                "2": { "name": "entity.name.tag.verb.operator.thaliak-diagram" },
                "3": { "name": "entity.name.tag.verb.thaliak-diagram" },
                "4": { "name": "entity.name.tag.verb.thaliak-diagram" }
            }
        },
        "continuation": {
            "begin": "^(\\d+)?\\s+(?=\\S)",
            "beginCaptures": {
                "1": { "name": "constant.numeric.time.thaliak-diagram" }
            },
            "end": "$",
            "patterns": [{ "include": "#arguments" }]
        },
        "arguments": {
            "patterns": [
                { "include": "#comment" },
                { "include": "#string" },
                { "include": "#player" },
                { "match": "(?<![\\w#-])(to|on|at|toward|for|rotate|over|offset|as|hits)(?![\\w#-])", "name": "keyword.operator.expression.thaliak-diagram" },
                { "match": "(?<![\\w#\\]-])[A-Za-z][\\w-]*(?=\\s+(?:-?\\.?\\d|\"|\\(|\\[|\\{|#|true\\b|false\\b))", "name": "variable.parameter.thaliak-diagram" },
                { "include": "#placeholder" },
                { "include": "#scalars" },
                {
                    "begin": "\\(",
                    "beginCaptures": { "0": { "name": "punctuation.section.parens.begin.thaliak-diagram" } },
                    "end": "\\)",
                    "endCaptures": { "0": { "name": "punctuation.section.parens.end.thaliak-diagram" } },
                    "patterns": [{ "include": "#arguments" }]
                },
                {
                    "begin": "\\[",
                    "beginCaptures": { "0": { "name": "punctuation.section.brackets.begin.thaliak-diagram" } },
                    "end": "\\]",
                    "endCaptures": { "0": { "name": "punctuation.section.brackets.end.thaliak-diagram" } },
                    "patterns": [{ "include": "#arguments" }]
                },
                { "include": "#id" },
                { "include": "#separators" }
            ]
        },
        "player": {
            "match": "(?<![\\w#/-])(?:T1|T2|H1|H2|M1|M2|R1|R2)(?![\\w#/-])",
            "name": "entity.name.type.player.thaliak-diagram"
        },
        "id": {
            "patterns": [
                { "include": "#player" },
                {
                    "comment": "A tether, which refers to its two ends: far-tether@T1>R2, plume-tether@enemy#satin-1>R1.",
                    "begin": "((?:(?<=\\])-)?[A-Za-z][\\w-]*)(@)",
                    "beginCaptures": {
                        "1": { "name": "entity.name.type.thaliak-diagram" },
                        "2": { "name": "punctuation.separator.at.thaliak-diagram" }
                    },
                    "end": "(?=[\\s,)\\]]|//|$)",
                    "patterns": [{ "include": "#tether-ends" }]
                },
                {
                    "begin": "((?:(?<=\\])-)?[A-Za-z][\\w-]*)(#)",
                    "beginCaptures": {
                        "1": { "name": "entity.name.type.thaliak-diagram" },
                        "2": { "name": "punctuation.separator.hash.thaliak-diagram" }
                    },
                    "end": "(?=[\\s,)\\]]|//|$)",
                    "patterns": [{ "include": "#sub-id" }]
                },
                { "match": "(?:(?<=\\])-)?[A-Za-z][\\w-]*", "name": "entity.name.type.thaliak-diagram" },
                { "include": "#placeholder" },
                { "include": "#template" },
                { "include": "#separators" }
            ]
        },
        "sub-id": {
            "patterns": [
                { "include": "#template" },
                { "include": "#placeholder" },
                { "match": "\\.\\.", "name": "keyword.operator.range.thaliak-diagram" },
                { "match": "[\\w*-]+", "name": "entity.name.variable.template.thaliak-diagram" }
            ]
        },
        "tether-ends": {
            "patterns": [
                { "include": "#template" },
                { "include": "#placeholder" },
                { "include": "#player" },
                { "match": ">", "name": "punctuation.separator.arrow.thaliak-diagram" },
                {
                    "match": "([A-Za-z][\\w-]*)(#)([\\w*-]+)",
                    "captures": {
                        "1": { "name": "entity.name.type.thaliak-diagram" },
                        "2": { "name": "punctuation.separator.hash.thaliak-diagram" },
                        "3": { "name": "entity.name.variable.template.thaliak-diagram" }
                    }
                },
                { "match": "[A-Za-z][\\w-]*", "name": "entity.name.type.thaliak-diagram" }
            ]
        },
        "template": {
            "begin": "\\[",
            "beginCaptures": { "0": { "name": "punctuation.section.brackets.begin.thaliak-diagram" } },
            "end": "\\]",
            "endCaptures": { "0": { "name": "punctuation.section.brackets.end.thaliak-diagram" } },
            "patterns": [
                { "include": "#separators" },
                { "include": "#sub-id" }
            ]
        },
        "placeholder": {
            "match": "<[^>\\s]+>",
            "name": "variable.language.placeholder.thaliak-diagram"
        },
        "string": {
            "patterns": [
                { "include": "#quoted-url" },
                { "include": "#quoted-text" }
            ]
        },
        "quoted-url": {
            "match": "(\")(url)(\\()(#)([A-Za-z][\\w-]*)(\\))(\")",
            "captures": {
                "1": { "name": "string.quoted.double.thaliak-diagram punctuation.definition.string.begin.thaliak-diagram" },
                "2": { "name": "entity.name.function.thaliak-diagram" },
                "3": { "name": "punctuation.section.parens.begin.thaliak-diagram" },
                "4": { "name": "punctuation.separator.hash.thaliak-diagram" },
                "5": { "name": "entity.name.type.thaliak-diagram" },
                "6": { "name": "punctuation.section.parens.end.thaliak-diagram" },
                "7": { "name": "string.quoted.double.thaliak-diagram punctuation.definition.string.end.thaliak-diagram" }
            }
        },
        "quoted-text": {
            "begin": "\"",
            "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.thaliak-diagram" } },
            "end": "\"|$",
            "endCaptures": { "0": { "name": "punctuation.definition.string.end.thaliak-diagram" } },
            "name": "string.quoted.double.thaliak-diagram",
            "patterns": [
                { "include": "#url" },
                { "include": "#hex-color" },
                { "include": "#function" },
                { "match": "(#)([A-Za-z][\\w-]*)", "captures": {
                    "1": { "name": "punctuation.separator.hash.thaliak-diagram" },
                    "2": { "name": "entity.name.type.thaliak-diagram" }
                } },
                { "match": "[()]", "name": "punctuation.section.parens.thaliak-diagram" }
            ]
        },
        "hex-color": {
            "match": "(?<![\\w-])(#)([0-9a-fA-F]{3,8})(?![\\w-])",
            "captures": {
                "1": { "name": "punctuation.definition.constant.thaliak-diagram" },
                "2": { "name": "constant.other.color.rgb-value.hex.thaliak-diagram" }
            }
        },
        "function": {
            "match": "(?<![\\w-])[a-zA-Z][\\w-]*(?=\\()",
            "name": "entity.name.function.thaliak-diagram"
        },
        "url": {
            "match": "(?<![\\w-])(url)(\\()(#)([A-Za-z][\\w-]*)(\\))",
            "captures": {
                "1": { "name": "entity.name.function.thaliak-diagram" },
                "2": { "name": "punctuation.section.parens.begin.thaliak-diagram" },
                "3": { "name": "punctuation.separator.hash.thaliak-diagram" },
                "4": { "name": "entity.name.type.thaliak-diagram" },
                "5": { "name": "punctuation.section.parens.end.thaliak-diagram" }
            }
        },
        "scalars": {
            "patterns": [
                { "include": "#url" },
                { "include": "#hex-color" },
                { "include": "#function" },
                { "match": "(?<![\\w-])(?:true|false)(?![\\w-])", "name": "constant.language.boolean.thaliak-diagram" },
                { "match": "(?<![\\w-])null(?![\\w-])", "name": "constant.language.null.thaliak-diagram" },
                { "match": "(?<![\\w.#+-])[+-]?\\d+(?:\\.\\d+)?(?:ms|s|%|deg)?(?![\\w-])", "name": "constant.numeric.thaliak-diagram" }
            ]
        },
        "separators": {
            "patterns": [
                { "match": ",", "name": "punctuation.separator.comma.thaliak-diagram" },
                { "match": ":", "name": "punctuation.separator.key-value.mapping.thaliak-diagram" }
            ]
        },
        "values": {
            "patterns": [
                { "include": "#string" },
                {
                    "match": "(?<![\\w-])(type|look|shape)\\s*(:)\\s*([a-zA-Z][\\w-]*)",
                    "captures": {
                        "1": { "name": "entity.name.tag.field.thaliak-diagram" },
                        "2": { "name": "punctuation.separator.key-value.mapping.thaliak-diagram" },
                        "3": { "name": "variable.other.enummember.thaliak-diagram" }
                    }
                },
                {
                    "match": "(?<![\\w-])([a-zA-Z][\\w-]*)\\s*(:)",
                    "captures": {
                        "1": { "name": "entity.name.tag.field.thaliak-diagram" },
                        "2": { "name": "punctuation.separator.key-value.mapping.thaliak-diagram" }
                    }
                },
                { "include": "#scalars" },
                { "match": "[{]", "name": "punctuation.section.braces.begin.thaliak-diagram" },
                { "match": "[}]", "name": "punctuation.section.braces.end.thaliak-diagram" },
                { "match": "\\(", "name": "punctuation.section.parens.begin.thaliak-diagram" },
                { "match": "\\)", "name": "punctuation.section.parens.end.thaliak-diagram" },
                { "match": "\\[", "name": "punctuation.section.brackets.begin.thaliak-diagram" },
                { "match": "\\]", "name": "punctuation.section.brackets.end.thaliak-diagram" },
                { "include": "#separators" },
                { "match": "[^\\s,:{}\\[\\]()\"]+", "name": "string.unquoted.plain.thaliak-diagram" }
            ]
        }
    }
}
