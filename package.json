{
    "name": "thaliak-timeline-linter",
    "displayName": "Thaliak Timeline Linter",
    "description": "A linter (but actually a full LSP) for thaliak.com timeline files.",
    "author": "Thaliak <contact@thaliak.com> (https://thaliak.com/)",
    "publisher": "thaliak",
    "license": "MIT",
    "version": "0.4.0",
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "keywords": [
        "thaliak",
        "ffxiv",
        "lsp",
        "language-server",
        "yaml"
    ],
    "repository": {
        "url": "https://github.com/thaliakcom/thaliak-timeline-linter/",
        "type": "git"
    },
    "homepage": "https://github.com/thaliakcom/thaliak-timeline-linter/",
    "bugs": {
        "url": "https://github.com/thaliakcom/thaliak-timeline-linter/issues",
        "email": "contact@thaliak.com"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "activationEvents": [
        "workspaceContains:**/enums/mechanic-types.yaml"
    ],
    "icon": "./icon.png",
    "galleryBanner": {
        "color": "#59a2e3",
        "theme": "light"
    },
    "main": "./out/client/src/extension",
    "contributes": {
        "configuration": {
            "type": "object",
            "title": "Thaliak Timeline Linter Configuration",
            "properties": {
                "thaliak-timeline-linter.maxNumberOfProblems": {
                    "scope": "resource",
                    "type": "number",
                    "default": 100,
                    "description": "Controls the maximum number of problems produced by the server."
                },
                "thaliak-timeline-linter.ironworksPath": {
                    "scope": "machine-overridable",
                    "type": "string",
                    "default": "",
                    "description": "The ironworks-cli executable, which reads game data (in-game names, descriptions and icons of actions and statuses). Empty: `ironworks-cli` from the PATH."
                },
                "thaliak-timeline-linter.gameDirectory": {
                    "scope": "machine-overridable",
                    "type": "string",
                    "default": "",
                    "description": "The FFXIV install directory (the one containing `boot` and `game`). Game data is off while this is empty."
                },
                "thaliak-timeline-linter.cachePath": {
                    "scope": "machine-overridable",
                    "type": "string",
                    "default": "",
                    "description": "The directory game data is cached in, laid out like thaliak's `.cache` (so it can point at it). The extension never clears a directory set here. Empty: the extension's own storage, which is cleared after game updates (except icons)."
                },
                "thaliak-timeline-linter.icons.status": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "description": "Shows the in-game icons of statuses inline, after status keys and in front of status references. Needs game data and inlay hints."
                },
                "thaliak-timeline-linter.icons.aoes": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "description": "Shows the icons of AoE shapes inline, in front of `shape` values, `ms:` references and the actions of `+aoe` statements. Needs inlay hints."
                },
                "thaliak-timeline-linter.icons.subIcons": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "description": "Shows the images of `i:` sub-icon and `hm:` headmarker references inline, in front of them. Needs inlay hints."
                },
                "thaliak-timeline-linter.completion.schemaEnums": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "description": "Suggests the values of the timeline schema's enums (e.g. for `shape`), with their descriptions. Turn off if the YAML extension's suggestions of the same values show up twice."
                },
                "thaliak-timeline-linter.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces the communication between VS Code and the language server."
                }
            }
        },
        "configurationDefaults": {
            "[thaliak-diagram]": {
                "editor.detectIndentation": false,
                "editor.insertSpaces": true,
                "editor.tabSize": 4
            }
        },
        "languages": [
            {
                "id": "thaliak-diagram",
                "aliases": ["Thaliak Diagram"],
                "extensions": [".diagram"],
                "configuration": "./syntax/diagram.language-configuration.json",
                "icon": { "light": "./media/diagram-file.svg", "dark": "./media/diagram-file.svg" }
            }
        ],
        "grammars": [
            {
                "language": "thaliak-diagram",
                "scopeName": "source.diagram.thaliak",
                "path": "./syntax/diagram.tmLanguage.json"
            },
            {
                "injectTo": [
                    "source.yaml"
                ],
                "scopeName": "source.timeline.template.thaliak",
                "path": "./syntax/template.tmLanguage.json"
            },
            {
                "injectTo": [
                    "source.yaml"
                ],
                "scopeName": "source.timeline.id-expression.thaliak",
                "path": "./syntax/id.tmLanguage.json"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "thaliak",
                    "title": "Thaliak",
                    "icon": "media/activity-bar.svg"
                }
            ]
        },
        "views": {
            "thaliak": [
                {
                    "id": "thaliak.outline",
                    "name": "Timeline",
                    "icon": "media/activity-bar.svg"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "thaliak.outline",
                "contents": "Open a Thaliak timeline file to see its outline."
            }
        ],
        "commands": [
            {
                "command": "thaliak-timeline-linter.restart",
                "title": "Restart language server",
                "category": "Thaliak Timeline Linter"
            },
            {
                "command": "thaliak-timeline-linter.outline.findReferences",
                "title": "Find All References",
                "icon": "$(references)"
            },
            {
                "command": "thaliak-timeline-linter.outline.goToDefinition",
                "title": "Go to Definition",
                "icon": "$(go-to-file)"
            }
        ],
        "menus": {
            "view/item/context": [
                {
                    "command": "thaliak-timeline-linter.outline.findReferences",
                    "when": "view == thaliak.outline && viewItem =~ /references/",
                    "group": "inline"
                },
                {
                    "command": "thaliak-timeline-linter.outline.goToDefinition",
                    "when": "view == thaliak.outline && viewItem =~ /definition/",
                    "group": "inline"
                }
            ],
            "commandPalette": [
                {
                    "command": "thaliak-timeline-linter.outline.findReferences",
                    "when": "false"
                },
                {
                    "command": "thaliak-timeline-linter.outline.goToDefinition",
                    "when": "false"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "deno task package",
        "compile-anew": "deno run -A ./get-objects.mjs && deno task check-types && deno run -A esbuild.mjs",
        "package-anew": "deno run -A ./get-objects.mjs && deno task check-types && deno run -A esbuild.mjs --production",
        "compile": "deno task check-types && deno run -A esbuild.mjs",
        "package": "deno task check-types && deno run -A esbuild.mjs --production",
        "check-types": "tsc --noEmit --project client && tsc --noEmit --project server",
        "watch": "deno task watch:esbuild & deno task watch:tsc",
        "watch:esbuild": "deno run -A esbuild.mjs --watch",
        "watch:tsc": "tsc --noEmit --watch --project client & tsc --noEmit --watch --project server",
        "lint": "eslint ./client/src ./server/src --ext .ts,.tsx",
        "postinstall": "cd client && deno install && cd ../server && deno install && cd ..",
        "test": "sh ./scripts/e2e.sh"
    },
    "devDependencies": {
        "@types/color-string": "^1.5.5",
        "@types/mocha": "^10.0.6",
        "@types/node": "^18.14.6",
        "@typescript-eslint/eslint-plugin": "^7.1.0",
        "@typescript-eslint/parser": "^7.1.0",
        "dotenv-cli": "^7.4.2",
        "esbuild": "^0.23.0",
        "eslint": "^8.57.0",
        "mocha": "^10.3.0",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "color-string": "^1.9.1"
    }
}
